<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!--
      Default values for the "serve" command CLI options. Any option can be supplied here
      using "CLI:<option-name-without-leading-dashes>" as the key. Values explicitly passed
      on the command line always take precedence over these defaults.

      <add key="CLI:users" value="C:\tools\ftpSrv\ftpSrv.ini" />
      <add key="CLI:staging" value="C:\inetpub\myFtp\staging" />
      <add key="CLI:bind" value="192.168.173.25" />
      <add key="CLI:port" value="2121" />
      <add key="CLI:passive-start" value="50000" />
      <add key="CLI:passive-end" value="50049" />
      <add key="CLI:passive-bind" value="192.168.173.25" />
      <add key="CLI:advertise" value="192.168.173.25" />
      <add key="CLI:allow-nonloopback" value="true" />
      <add key="CLI:priority-nic" value="/^Ethernet.*$/" />
      <add key="CLI:log" value="C:\logs\ftpSrv.log" />
    -->

      <add key="CLI:users" value="C:\tools\ftpSrv\ftpSrv.ini" />
      <add key="CLI:staging" value="C:\inetpub\myFtp\staging" />
      <add key="CLI:bind" value="btoTestWs" />
      <add key="CLI:allow-nonloopback" value="true" />
      <add key="CLI:enable-vpn" value="true" />
      <add key="CLI:priority-nic" value="Ethernet 3" />
      <add key="CLI:log" value="ftpSrv.log" />

  </appSettings>
</configuration>
